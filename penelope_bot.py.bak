import json, os
from groq import Groq
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters

BOT_TOKEN = "8671512106:AAEnLnUr0f7rCVJ0XFniYb9Gh4RK3jj0PqU"
CHAT_ID = "6183015901"
GROQ_KEY = os.getenv("GROQ_API_KEY", "")

MEM = "/root/workspace/Penelope/memory.json"
SYS = "You are Penelope, AI assistant for Guerilla Holdings LLC. Help Sydney with missions, automation and business strategy. Remember previous conversations. Be concise. RULES: Never invent revenue numbers or financial data - say you lack live data. Never fabricate approvals or pipeline values. Guerilla Holdings has one person: Sydney."

def load():
    try: return json.load(open(MEM))
    except: return {}

def save(h): json.dump(h, open(MEM,"w"))

h = load()

def reply(uid, msg):
    global h
    k = str(uid)
    h[k] = h.get(k, [])
    h[k].append({"role":"user","content":msg})
    if not GROQ_KEY:
        return "GROQ_API_KEY not set."
    client = Groq(api_key=GROQ_KEY)
    r = client.chat.completions.create(
        model="llama3-70b-8192",
        messages=[{"role":"system","content":SYS}] + h[k][-20:]
    )
    out = r.choices[0].message.content
    h[k].append({"role":"assistant","content":out})
    save(h)
    return out

async def start(u,c): await u.message.reply_text("Penelope online for Guerilla Holdings.")
async def clear(u,c):
    h.pop(str(u.effective_user.id),None); save(h)
    await u.message.reply_text("Memory cleared.")
async def handle(u,c):
    await u.message.reply_text(reply(u.effective_user.id, u.message.text))

if __name__ == "__main__":
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("clear", clear))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle))
    print("Penelope running...")
    app.run_polling()
