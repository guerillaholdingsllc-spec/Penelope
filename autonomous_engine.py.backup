REPO = "guerillaholdingsllc-spec/Penelope"
FEED_FILE = "/root/workspace/Penelope/feed.json"
WORK_DIR = "/root/workspace/Penelope/shipped"

client = genai.Client(api_key=GOOGLE_API_KEY)

REVENUE_MISSIONS = [
